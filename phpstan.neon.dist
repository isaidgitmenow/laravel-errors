includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src

    excludePaths:
        - src/Integrations/Livewire/ExceptionHook.php
        - src/Integrations/Sentry/AttributesEventProcessor.php

    phpVersion: 80400

    ignoreErrors:
        # Optional dependencies not installed during dev/CI
        - message: '#on an unknown class Barryvdh\\Debugbar\\#'
          reportUnmatched: false
        - message: '#on an unknown class Filament\\#'
          reportUnmatched: false
        - message: '#an unknown class Sentry\\#'
          reportUnmatched: false
        - message: '#type Sentry\\#'
          reportUnmatched: false
        - message: '#Class Sentry\\#'
          reportUnmatched: false
        - message: '#unknown class Livewire\\#'
          reportUnmatched: false
        - message: '#undefined property [a-zA-Z0-9_\\]+::\$component#'
          path: src/Integrations/Livewire/ExceptionHook.php
          reportUnmatched: false
        - message: '#Constructor of class [a-zA-Z0-9_\\]+ has an unused parameter \$config\.#'
          reportUnmatched: false

        # Pre-existing: renderers/reporters that never return null (interface requires nullable)
        - message: '#never returns null so it can be removed from the return type#'
          reportUnmatched: false

        # Xdebug is an optional extension not present in CI — suppress the unknown function error.
        # The call is guarded at runtime by function_exists('xdebug_notify').
        - message: '#Function xdebug_notify not found#'
          reportUnmatched: false

        # PHPStan thinks optimizes() always exists in Laravel 11+, but we check for older versions
        - message: "#Call to function method_exists.* and 'optimizes' will always evaluate to true.#"
          reportUnmatched: false
